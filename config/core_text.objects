# core_text, in link order = retail address order. One object per line.
# Makefile.sn, rac1.ld.sh and the tools all read this file.
#
# Object boundaries are retail's own: the linker filled the gaps between
# objects with 0xCDCDCDCD, and every such run starts a new object here
# (plus 0x12DB18, where the compiler sub-build changes).
#
# Game objects carry their retail start address as a second column. They
# are named by that address until their real source file is identified,
# then renamed (e.g. 989snd): only the name changes, the address stays.
#   build-sn/core/<NAME>.o <START>   <- src/core/<NAME>.c
#   build-sn/libgcc/l2_*.o     <- src/libgcc/libgcc2.c
#   build-sn/libgcc/fp_*.o     <- src/libgcc/fp-bit.c
#   build-sn/libgcc/asm_*.o    <- src/libgcc/nonmatching_*.c

build-sn/core/00112380.o 0x00112380
