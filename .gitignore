# Never commit dumps, ROMs, or anything extracted from the original disc.
baserom*/

# Third-party toolchain mirrors (e.g. SN Systems ProDG) - local tooling only,
# never committed. See docs/TOOLCHAIN.md.
toolchain/
*.iso
*.bin
*.cue
*.elf
disks/

# Build output
build/
*.o
*.map

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python
venv*/
__pycache__/
*.pyc
build-sn/

# Editor/tool configs that are not part of the project
opencode.json

# Ghidra reference decompilation -- regenerate with tools/ghidra/run_headless.sh.
# The table and the tooling are tracked; the multi-megabyte dumps are not.
docs/ghidra/*.c
# Generated by tools/ghidra_export_progress.py -- do not commit, regenerate locally.
tools/ghidra_import.json

# Stray artifacts from tool bootstrap scripts -- never part of the project.
Python/
python_install_*.log

# Third-party decomp tools (m2c, asm-differ) -- cloned locally, not vendored.
tools/ext/
ctx.c
ctx.c.m2c

# Disassembly of the retail executable -- regenerate with tools/setup_asm.sh.
# It carries the original instruction bytes, so it never goes in the repo.
asm/
# Assets splat extracts from the executable.
assets/
.aider*

# Ghidra project files -- these are local to each contributor's machine.
*.gpr
*.lock
*.lock~
*.rep/
pyghidra_mcp_projects/

# One-off scratch / helper scripts created during a session.
patch_*.py
get_count.py
get_func.py
get_funcs.py
run_test.py
push_ghidra.py
update_db.py
query.py
scratch.c
tools/create_ghidra_project.py
16
rac1_ld_numbered.txt
ghidra-ee.zip

# AI Decomp platform local data (database, local model training datasets, logs)
tools/platform/data/
*.db
*.sqlite
*.sqlite3
dataset*.jsonl
