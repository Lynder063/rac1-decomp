# Never commit dumps, ROMs, or anything extracted from the original disc.
baserom*/

# Third-party toolchain mirrors (e.g. SN Systems ProDG) - local tooling only,
# never committed. See docs/TOOLCHAIN.md.
toolchain/
*.iso
*.bin
*.cue
*.elf
disks/

# Build output
build/
*.o
*.map

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
build-sn/

# Editor/tool configs that are not part of the project
opencode.json

# Ghidra reference decompilation -- regenerate with tools/ghidra/run_headless.sh.
# The table and the tooling are tracked; the multi-megabyte dumps are not.
docs/ghidra/*.c

# Stray artifacts from tool bootstrap scripts -- never part of the project.
Python/
python_install_*.log
