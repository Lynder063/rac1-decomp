# Build against the era-accurate SN Systems ProDG GCC 2.95.3 toolchain
# (see docs/TOOLCHAIN.md). Local-only, gitignored -- get it yourself:
#   git clone https://github.com/AngheloAlf/SN-Systems-ProDG_for_PS2_3.01 \
#       toolchain/sn-prodg-3.01
#
# Unlike the modern-binutils Makefile, this one does NOT need
# tools/fix_vu0_macro.py (this assembler supports VU0 macro-mode natively)
# but DOES need tools/sn_regnames.py run over asm/ first (this assembler
# only accepts numeric GPR names) -- both scripts are idempotent, safe to
# re-run after every `splat split`.

# PER-SEGMENT COMPILERS. Retail's two segments were built with two
# different SN sub-builds, which is why no single compiler ever matched
# both (see docs/DECOMP_PROGRESS.md, the sq/lq section). Measured across
# all of retail's disassembly:
#
#   core_text: 234 s-reg spills via sd,  14 via sq  -> matches v1.36
#   text:       34 s-reg spills via sd, 428 via sq  -> matches v1.14
#   (plus 520 text functions saving $ra via sq, which v1.36 never emits)
#
# Both compilers are already in the toolchain mirrors, so the fix is just
# to use the right one per file. Identical everything else (-O2 -G0); the
# only codegen difference between the sub-builds is the spill pair.
SN_136  := toolchain/sn-prodg-3.01/usr/local/sce/ee/gcc
SN_114  := toolchain/sn-prodg-24/local/sce/ee/gcc

# core_text is built with v1.14 too -- NOT v1.36 -- then post-processed.
# See the build-sn/core/%.o rule below for why.
CC_CORE := $(SN_114)/bin/ee-gcc2953.exe
CC_TEXT := $(SN_114)/bin/ee-gcc2953.exe
SIZE    := $(SN_136)/bin/ee-size.exe

# -G2, NOT -G0. The small-data threshold has to sit in 1..3:
#   -G0        no $gp addressing at all -> the ~244 text functions that
#              use $gp can never match
#   -G1..-G3   small globals go via $gp AND float constants stay inline
#              (lui/ori/mtc1), which is what retail does
#   -G4+       float constants get pooled into .lit4 and addressed via
#              $gp, which retail never does -- and .lit4 has nowhere to
#              live, since the SDA window is fully occupied
# Verified: -G1/-G2/-G3 all link clean with zero regressions vs -G0.
CFLAGS := -O2 -G2 -Iinclude -Wa,-I,.

# libgcc (0x11DF0C-0x1206A0): GCC's own libgcc2.c and fp-bit.c, one object
# per L_* module like libgcc.a's members. Built with Sony's 2.9-ee, NOT the
# game's 2.95.3 -- see src/libgcc/README.md. Modules that do not match yet
# are asm stubs (nonmatching_*.c).
#
# Through the 2.9-ee DRIVER, not cc1 directly: the driver passes the
# target predefines (__mips__, __R5900__, ...), and longlong.h picks its
# MIPS multiply/divide primitives off them. Without them __divdi3 and
# __muldi3 come out wrong.
CC_LIBGCC := $(SN_114)/bin/ee-gcc.exe

# Every core_text object, in link order, from the one list that rac1.ld.sh
# and the tools also read.
CORE_TEXT_OBJS := $(shell grep -v -e "^\#" -e "^$$" config/core_text.objects | cut -d" " -f1)

TEXT_OBJS := $(shell grep -v -e "^\#" -e "^$$" config/text.objects | cut -d" " -f1)

OBJS := $(CORE_TEXT_OBJS) $(TEXT_OBJS)

.PHONY: all clean regnames
all: regnames $(OBJS)
	$(SIZE) $(OBJS)

regnames:
	python tools/sn_regnames.py asm

# core_text game objects (src/core/<ADDR>.c): compile to assembly with
# v1.14, narrow the callee-saved spills to sd/ld, then assemble. Neither
# compiler reproduces retail's core_text alone:
#   v1.36  spills $ra as sd but $s0-$s7 as sq, AND mirrors the save-slot
#          layout ($31 at offset 0, s-regs descending)
#   v1.14  lays slots out EXACTLY as retail does ($16 at 0, s-regs
#          ascending, $31 at top) but spills everything as sq
# Retail core_text == v1.14's layout + sd/ld mnemonics. Since the layout
# already matches, this is a pure mnemonic substitution -- frame size,
# the 16-byte slot stride (which retail keeps even for 8-byte stores)
# and every offset are left exactly as v1.14 emitted them. No offset
# arithmetic, which is what makes it safe. (fix_core_spills keys on
# address, so the objects from 0x12DB18 on keep their sq spills.)
build-sn/core/%.o: src/core/%.c tools/fix_core_spills.py tools/fix_tail_calls.py
	@mkdir -p build-sn/core
	$(CC_CORE) $(CFLAGS) -S -o build-sn/core/$*.s $<
	python tools/fix_core_spills.py build-sn/core/$*.s build-sn/core/$*_sp.s
	python tools/fix_tail_calls.py build-sn/core/$*_sp.s build-sn/core/$*_fixed.s
	$(CC_CORE) $(CFLAGS) -c build-sn/core/$*_fixed.s -o $@

# libgcc modules: verbatim GCC source, no rewriters.
LIBGCC_CFLAGS := -O2 -G2 -S

build-sn/libgcc/fp_%.o: src/libgcc/fp-bit.c
	@mkdir -p build-sn/libgcc
	$(CC_LIBGCC) $(LIBGCC_CFLAGS) -DFINE_GRAINED_LIBRARIES -DL_$* $< -o build-sn/libgcc/fp_$*.s
	$(CC_TEXT) -c build-sn/libgcc/fp_$*.s -o $@

# float_to_usi only exists in this fp-bit revision under GOFAST (where it
# is named dptoul); the code is identical to retail's.
build-sn/libgcc/fp_df_to_usi.o: src/libgcc/fp-bit.c
	@mkdir -p build-sn/libgcc
	$(CC_LIBGCC) $(LIBGCC_CFLAGS) -DFINE_GRAINED_LIBRARIES -DL_df_to_usi -DUS_SOFTWARE_GOFAST $< -o build-sn/libgcc/fp_df_to_usi.s
	$(CC_TEXT) -c build-sn/libgcc/fp_df_to_usi.s -o $@

build-sn/libgcc/l2_%.o: src/libgcc/libgcc2.c src/libgcc/longlong.h
	@mkdir -p build-sn/libgcc
	$(CC_LIBGCC) $(LIBGCC_CFLAGS) -Isrc/libgcc/include -DIN_LIBGCC2 -DL_$* $< -o build-sn/libgcc/l2_$*.s
	$(CC_TEXT) -c build-sn/libgcc/l2_$*.s -o $@

# Not-yet-matching libgcc modules and linker fill: asm only.
build-sn/libgcc/asm_%.o: src/libgcc/nonmatching_%.c
	@mkdir -p build-sn/libgcc
	$(CC_TEXT) $(CFLAGS) -c $< -o $@

# text objects (src/game/**.c) need the tail-call rewrite, but NOT
# fix_core_spills: retail's text segment uses sq/lq, which v1.14 emits.
build-sn/game/%.o: src/game/%.c tools/fix_tail_calls.py
	@mkdir -p $(dir $@)
	$(CC_TEXT) $(CFLAGS) -S -o build-sn/game/$*.s $<
	python tools/fix_tail_calls.py build-sn/game/$*.s build-sn/game/$*_fixed.s
	$(CC_TEXT) $(CFLAGS) -c build-sn/game/$*_fixed.s -o $@

clean:
	rm -rf build-sn
